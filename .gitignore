# ---- 崩溃报告与日志 ----
sysinfo.txt
*.log
crashlytics-build.properties

# ---- 构建产物 ----
*.apk
*.aab
*.unitypackage
*.app
/[Bb]uilds/
/[Ll]ogs/

# ---- Addressables / StreamingAssets 自动生成内容 ----
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- 编辑器与本机个人配置 ----
.idea/
.vs/
.vscode/
*.swp
.DS_Store
Thumbs.db

