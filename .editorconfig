# 本工程 C# 代码风格基准
#
# 依据：`Docs/工程标准.md`（用户长期指令：「以后代码要按游戏公司标准实现」）
# 本文件是**可执行**的风格约定：IDE 与 `dotnet format` 会读取它。
# 约定基线取自既有代码的实际风格（Day 1–3 已通过 4 轮整改），**不是**另起一套。

root = true

# ── 通用 ────────────────────────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,asmdef,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sh,ps1}]
indent_size = 2

# ── C# ──────────────────────────────────────────────────────────────────────
[*.cs]

# 格式：与既有代码一致（Allman 大括号、case 内容缩进）
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# 空行与修饰符顺序
dotnet_sort_system_directives_first = true
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# ── 命名约定（与既有代码逐条对齐）──────────────────────────────────────────
# 常量 / 静态只读字段 / 公有成员 / 方法 → PascalCase
dotnet_naming_rule.pascal_case_for_constants.symbols = constants
dotnet_naming_rule.pascal_case_for_constants.style = pascal_case
dotnet_naming_rule.pascal_case_for_constants.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.pascal_case_for_public_members.symbols = public_members
dotnet_naming_rule.pascal_case_for_public_members.style = pascal_case
dotnet_naming_rule.pascal_case_for_public_members.severity = warning
dotnet_naming_symbols.public_members.applicable_kinds = property,method,event,field
dotnet_naming_symbols.public_members.applicable_accessibilities = public,internal,protected,protected_internal

# 私有实例字段 → _camelCase（既有代码即此形，如 `_config` / `_outputDirOverride`）
dotnet_naming_rule.underscore_for_private_fields.symbols = private_fields
dotnet_naming_rule.underscore_for_private_fields.style = underscore_camel_case
dotnet_naming_rule.underscore_for_private_fields.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers = static

# 局部变量 / 参数 → camelCase
dotnet_naming_rule.camel_case_for_locals.symbols = locals_and_params
dotnet_naming_rule.camel_case_for_locals.style = camel_case
dotnet_naming_rule.camel_case_for_locals.severity = suggestion
dotnet_naming_symbols.locals_and_params.applicable_kinds = local,parameter
dotnet_naming_symbols.locals_and_params.applicable_accessibilities = *

# 类型 / 命名空间 → PascalCase
dotnet_naming_rule.pascal_case_for_types.symbols = types_and_namespaces
dotnet_naming_rule.pascal_case_for_types.style = pascal_case
dotnet_naming_rule.pascal_case_for_types.severity = warning
dotnet_naming_symbols.types_and_namespaces.applicable_kinds = namespace,class,struct,interface,enum,delegate,type_parameter
dotnet_naming_symbols.types_and_namespaces.applicable_accessibilities = *

# 接口 → IPascalCase（本工程暂无接口，先立规则）
dotnet_naming_rule.interface_prefix.symbols = interfaces
dotnet_naming_rule.interface_prefix.style = i_pascal_case
dotnet_naming_rule.interface_prefix.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_style.i_pascal_case.required_prefix = I
dotnet_naming_style.i_pascal_case.capitalization = pascal_case

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# ── 语言特性倾向（务实，不激进）────────────────────────────────────────────
# Unity 序列化字段必须是 public 字段（不改为属性）
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# 只用 var 于类型显而易见处
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# 表达式体成员：短成员可用
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# using：保留 System 在前（已由 dotnet_sort_system_directives_first 覆盖）
dotnet_diagnostic.IDE0005.severity = warning   # 多余的 using
